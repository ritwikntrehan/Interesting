{
  "name": "world-data-federation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n web,worker -c cyan,magenta \"vite --host 0.0.0.0\" \"wrangler dev --port 8787\"",
    "build": "vite build && WRANGLER_LOG_PATH=.wrangler/build.log wrangler deploy --dry-run --outdir dist/worker",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "tsx tests/live-smoke.ts",
    "test:live:analytics": "tsx tests/live-analytics.ts",
    "test:live:discovery": "tsx tests/live-discovery.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply world-data-federation-cache --local",
    "db:migrate:remote": "wrangler d1 migrations apply world-data-federation-cache --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.10.4",
    "maplibre-gl": "^6.18.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261117.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "jsdom": "^27.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8",
    "wrangler": "4.163.0"
  },
  "engines": {"node": ">=22.12"}
}
